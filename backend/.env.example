PORT=3000
MONGODB_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/portafolio?retryWrites=true&w=majority

# Credenciales de Cloudinary
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret

# Opcional para producción: Restringir origen CORS y proteger endpoints de escritura (POST/PUT/DELETE)
# FRONTEND_URL=https://tu-dominio.com
# ADMIN_SECRET=tu_clave_secreta_de_admin
