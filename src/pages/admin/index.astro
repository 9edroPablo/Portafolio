---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';
---

<Layout>
  <main class="max-w-5xl mx-auto px-6 py-12 font-sans space-y-12">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h1 class="text-3xl font-extrabold text-gray-900">Panel de Administración</h1>
        <p class="text-sm text-gray-500 mt-1">Crea, previsualiza, publica o archiva tus artículos.</p>
      </div>
      <div class="flex items-center gap-4">
        <div class="flex items-center gap-2">
          <input
            type="password"
            id="admin-key-input"
            placeholder="Clave Admin (opcional en local)"
            class="px-3 py-1.5 text-xs border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"
            title="Si configuraste ADMIN_SECRET en backend/.env, ingresa la clave aquí"
          />
        </div>
        <a href="/blog" class="text-sm font-semibold text-blue-600 hover:text-blue-800 whitespace-nowrap">
          Ir al Blog Público &rarr;
        </a>
      </div>
    </div>
    
    <!-- SECCIÓN 1: FORMULARIO DE CREACIÓN -->
    <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
      <h2 class="text-xl font-bold mb-6 text-gray-900">Crear Nuevo Artículo</h2>
      
      <!-- Agregamos enctype="multipart/form-data" para permitir subida de archivos -->
      <form id="post-form" class="space-y-6" enctype="multipart/form-data">
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Título del artículo</label>
            <input type="text" id="title-input" name="title" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Slug (URL amigable)</label>
            <input type="text" id="slug-input" name="slug" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Resumen</label>
          <textarea name="summary" rows="2" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></textarea>
        </div>

        <!-- SECCIÓN: Tecnologías -->
        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Tecnologías (separadas por coma)</label>
          <input type="text" name="technologies" placeholder="ej. astro, nodejs, react" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
        </div>

        <!-- SECCIÓN: Imágenes -->
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 p-4 bg-gray-50 rounded-lg border border-gray-200">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Imagen de Portada</label>
            <input type="file" name="coverImage" accept="image/*" class="w-full text-sm text-gray-600">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Imagen de Contenido</label>
            <input type="file" name="contentImage" accept="image/*" class="w-full text-sm text-gray-600">
          </div>
        </div>

        <!-- SECCIÓN: Estilos Dinámicos -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 p-4 bg-blue-50 rounded-lg border border-blue-100">
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Color de Fondo</label>
            <input type="color" name="bgColor" value="#ffffff" class="w-full h-10 rounded cursor-pointer border-0">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Color de Texto</label>
            <input type="color" name="textColor" value="#1f2937" class="w-full h-10 rounded cursor-pointer border-0">
          </div>
          <div>
            <label class="block text-sm font-semibold text-gray-700 mb-2">Tipografía del Título</label>
            <select name="titleFont" class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
              <option value="sans-serif">Sans Serif (Moderna)</option>
              <option value="serif">Serif (Clásica)</option>
              <option value="monospace">Monospace (Código)</option>
            </select>
          </div>
        </div>

        <div>
          <label class="block text-sm font-semibold text-gray-700 mb-2">Contenido Completo</label>
          <textarea name="content" rows="6" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500"></textarea>
        </div>

        <button type="submit" id="submit-btn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-4 rounded-lg transition-colors cursor-pointer">
          Guardar como Borrador
        </button>
      </form>
      
      <div id="status-message" class="mt-4 hidden p-4 rounded-lg font-semibold text-center"></div>
    </div>

    <!-- SECCIÓN 2: GESTIÓN DE ARTÍCULOS Y PESTAÑAS -->
    <div class="bg-white p-8 rounded-2xl shadow-sm border border-gray-100">
      <!-- Tarjetas de Métricas Globales (Solo visibles en /admin) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mb-8">
        <div class="flex items-center justify-between p-5 rounded-xl bg-blue-50 border border-blue-100">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-blue-600">Visitas Totales a la Página</p>
            <p id="total-site-visits" class="text-3xl font-extrabold text-gray-900 mt-1">0</p>
          </div>
          <span class="text-3xl">🌐</span>
        </div>
        <div class="flex items-center justify-between p-5 rounded-xl bg-indigo-50 border border-indigo-100">
          <div>
            <p class="text-xs font-bold uppercase tracking-wider text-indigo-600">Vistas Totales en Artículos</p>
            <p id="total-post-views" class="text-3xl font-extrabold text-gray-900 mt-1">0</p>
          </div>
          <span class="text-3xl">📖</span>
        </div>
      </div>

      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-6">
        <h2 class="text-xl font-bold text-gray-900">Gestión de Artículos</h2>
        
        <!-- Pestañas (Tabs) -->
        <div class="inline-flex bg-gray-100 p-1 rounded-xl" role="tablist">
          <button
            type="button"
            data-status="draft"
            class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg transition-all cursor-pointer bg-white text-blue-600 shadow-sm"
          >
            Borradores
          </button>
          <button
            type="button"
            data-status="published"
            class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg transition-all cursor-pointer text-gray-600 hover:text-gray-900"
          >
            Publicados
          </button>
          <button
            type="button"
            data-status="archived"
            class="tab-btn px-4 py-2 text-sm font-semibold rounded-lg transition-all cursor-pointer text-gray-600 hover:text-gray-900"
          >
            Archivados
          </button>
        </div>
      </div>

      <!-- Mensaje de feedback al cambiar estado -->
      <div id="list-feedback" class="mb-4 hidden p-3 rounded-lg text-sm font-semibold text-center"></div>

      <!-- Contenedor dinámico de la lista de artículos -->
      <div id="posts-container" class="space-y-4">
        <p class="text-gray-500 text-center py-8">Cargando artículos...</p>
      </div>
    </div>
  </main>
</Layout>

<script>
  const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
  const API_URL = `${API_BASE}/api/posts`;

  const form = document.getElementById('post-form') as HTMLFormElement;
  const statusMessage = document.getElementById('status-message') as HTMLElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const titleInput = document.getElementById('title-input') as HTMLInputElement;
  const slugInput = document.getElementById('slug-input') as HTMLInputElement;
  const adminKeyInput = document.getElementById('admin-key-input') as HTMLInputElement;

  const tabButtons = document.querySelectorAll('.tab-btn');
  const postsContainer = document.getElementById('posts-container') as HTMLElement;
  const listFeedback = document.getElementById('list-feedback') as HTMLElement;
  const totalSiteVisitsEl = document.getElementById('total-site-visits') as HTMLElement;
  const totalPostViewsEl = document.getElementById('total-post-views') as HTMLElement;

  let currentStatus = 'draft';

  // Función para cargar las métricas globales en el panel de administración
  async function loadMetrics() {
    try {
      const response = await fetch(`${API_BASE}/api/metrics`);
      if (response.ok) {
        const data = await response.json();
        if (totalSiteVisitsEl) totalSiteVisitsEl.textContent = String(data.totalVisits ?? 0);
        if (totalPostViewsEl) totalPostViewsEl.textContent = String(data.totalPostViews ?? 0);
      }
    } catch (error) {
      // Fallo silencioso si el endpoint aún no responde
    }
  }

  // Persistencia opcional de la clave de administrador en sessionStorage
  if (adminKeyInput) {
    adminKeyInput.value = sessionStorage.getItem('admin_secret_key') || '';
    adminKeyInput.addEventListener('input', () => {
      sessionStorage.setItem('admin_secret_key', adminKeyInput.value.trim());
    });
  }

  function getAuthHeaders(extraHeaders: Record<string, string> = {}) {
    const headers: Record<string, string> = { ...extraHeaders };
    const key = adminKeyInput?.value.trim();
    if (key) {
      headers['x-admin-key'] = key;
    }
    return headers;
  }

  // Autogenerar slug amigable a partir del título si el usuario no lo ha editado manualmente
  let slugEditedManually = false;
  slugInput?.addEventListener('input', () => {
    slugEditedManually = slugInput.value.trim().length > 0;
  });

  titleInput?.addEventListener('input', () => {
    if (!slugEditedManually && slugInput) {
      slugInput.value = titleInput.value
        .toLowerCase()
        .normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '')
        .replace(/[^a-z0-9\s-]/g, '')
        .trim()
        .replace(/\s+/g, '-');
    }
  });

  // Función para mostrar notificación breve en la sección de listado
  function showListFeedback(message: string, isError = false) {
    listFeedback.textContent = message;
    listFeedback.className = `mb-4 p-3 rounded-lg text-sm font-semibold text-center block ${
      isError ? 'bg-red-100 text-red-700' : 'bg-green-100 text-green-700'
    }`;
    setTimeout(() => {
      listFeedback.classList.add('hidden');
    }, 3500);
  }

  // Función para cargar los artículos según el estado de la pestaña activa
  async function loadPosts(status: string) {
    loadMetrics();
    postsContainer.innerHTML = `<p class="text-gray-500 text-center py-8">Cargando artículos...</p>`;

    try {
      const response = await fetch(`${API_URL}?status=${status}`);
      if (!response.ok) {
        throw new Error('Error al obtener los artículos');
      }
      const posts = await response.json();

      if (!Array.isArray(posts) || posts.length === 0) {
        const emptyLabels: Record<string, string> = {
          draft: 'No hay borradores pendientes.',
          published: 'Aún no hay artículos publicados.',
          archived: 'No hay artículos archivados.'
        };
        postsContainer.innerHTML = `
          <div class="text-center py-10 bg-gray-50 rounded-xl border border-dashed border-gray-200">
            <p class="text-gray-500 font-medium">${emptyLabels[status] || 'No hay artículos en esta sección.'}</p>
          </div>
        `;
        return;
      }

      postsContainer.innerHTML = posts.map((post: any) => {
        const dateStr = post.publishedAt
          ? new Date(post.publishedAt).toLocaleDateString('es-ES', {
              day: '2-digit',
              month: 'short',
              year: 'numeric'
            })
          : 'Sin fecha';

        const techBadges = Array.isArray(post.technologies) && post.technologies.length > 0
          ? `<div class="flex flex-wrap gap-1.5 mt-2">
              ${post.technologies.map((t: string) => `<span class="px-2 py-0.5 text-xs font-medium bg-gray-100 text-gray-700 rounded">${t}</span>`).join('')}
            </div>`
          : '';

        // Botones de acción según el estado actual
        let actionButtons = `
          <a
            href="/admin/preview/${post._id}"
            class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg bg-gray-100 text-gray-800 hover:bg-gray-200 transition-colors"
          >
            👁️ Ver Vista Previa
          </a>
        `;

        if (status !== 'published') {
          actionButtons += `
            <button
              type="button"
              data-action="change-status"
              data-id="${post._id}"
              data-target-status="published"
              class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg bg-green-600 text-white hover:bg-green-700 transition-colors cursor-pointer"
            >
              🚀 Publicar
            </button>
          `;
        }

        if (status !== 'draft') {
          actionButtons += `
            <button
              type="button"
              data-action="change-status"
              data-id="${post._id}"
              data-target-status="draft"
              class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg bg-amber-500 text-white hover:bg-amber-600 transition-colors cursor-pointer"
            >
              📝 Mover a Borrador
            </button>
          `;
        }

        if (status !== 'archived') {
          actionButtons += `
            <button
              type="button"
              data-action="change-status"
              data-id="${post._id}"
              data-target-status="archived"
              class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg bg-gray-600 text-white hover:bg-gray-700 transition-colors cursor-pointer"
            >
              📦 Archivar
            </button>
          `;
        }

        actionButtons += `
          <button
            type="button"
            data-action="delete-post"
            data-id="${post._id}"
            data-title="${post.title}"
            class="inline-flex items-center px-3 py-1.5 text-xs font-semibold rounded-lg bg-red-50 text-red-600 hover:bg-red-100 transition-colors cursor-pointer"
          >
            🗑️ Eliminar
          </button>
        `;

        const viewsCount = post.views || 0;

        return `
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 p-5 rounded-xl border border-gray-200 hover:border-gray-300 transition-all bg-white">
            <div class="space-y-1">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="text-lg font-bold text-gray-900">${post.title}</h3>
                <span class="text-xs text-gray-400 font-mono">/${post.slug}</span>
                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-bold bg-blue-50 text-blue-700 border border-blue-200" title="Lecturas únicas registradas">
                  📊 ${viewsCount} ${viewsCount === 1 ? 'vista' : 'vistas'}
                </span>
              </div>
              <p class="text-sm text-gray-600 line-clamp-2">${post.summary}</p>
              <div class="text-xs text-gray-400 pt-1">Fecha: ${dateStr}</div>
              ${techBadges}
            </div>
            <div class="flex flex-wrap items-center gap-2 shrink-0">
              ${actionButtons}
            </div>
          </div>
        `;
      }).join('');
    } catch (error) {
      postsContainer.innerHTML = `
        <div class="p-4 rounded-xl bg-red-50 border border-red-200 text-red-700 text-center text-sm font-medium">
          No se pudo conectar con el servidor backend en <code>${API_BASE}</code>. Verifica que esté encendido.
        </div>
      `;
    }
  }

  // Función para actualizar el estado de un artículo (PUT /api/posts/:id)
  async function updatePostStatus(id: string, newStatus: string) {
    try {
      const payload: Record<string, any> = { status: newStatus };
      if (newStatus === 'published') {
        payload.publishedAt = new Date().toISOString();
      }

      const response = await fetch(`${API_URL}/${id}`, {
        method: 'PUT',
        headers: getAuthHeaders({ 'Content-Type': 'application/json' }),
        body: JSON.stringify(payload)
      });

      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error || 'No se pudo actualizar el estado del artículo');
      }

      const statusLabels: Record<string, string> = {
        published: '¡Artículo publicado con éxito! 🎉',
        draft: 'Artículo movido a borradores.',
        archived: 'Artículo archivado correctamente.'
      };

      showListFeedback(statusLabels[newStatus] || 'Estado actualizado.');
      await loadPosts(currentStatus);
    } catch (error: any) {
      showListFeedback(error.message || 'Error al actualizar el estado del artículo.', true);
    }
  }

  // Función para eliminar un artículo (DELETE /api/posts/:id)
  async function deletePost(id: string, title: string) {
    if (!confirm(`¿Seguro que deseas eliminar permanentemente "${title}"?`)) {
      return;
    }

    try {
      const response = await fetch(`${API_URL}/${id}`, {
        method: 'DELETE',
        headers: getAuthHeaders()
      });

      if (!response.ok) {
        const err = await response.json().catch(() => ({}));
        throw new Error(err.error || 'No se pudo eliminar el artículo');
      }

      showListFeedback('Artículo eliminado correctamente.');
      await loadPosts(currentStatus);
    } catch (error: any) {
      showListFeedback(error.message || 'Error al eliminar el artículo.', true);
    }
  }

  // Delegación de eventos para los botones de acción dentro de #posts-container
  postsContainer?.addEventListener('click', async (e) => {
    const statusBtn = (e.target as HTMLElement).closest('button[data-action="change-status"]') as HTMLButtonElement | null;
    if (statusBtn) {
      const id = statusBtn.getAttribute('data-id');
      const newStatus = statusBtn.getAttribute('data-target-status');
      if (!id || !newStatus) return;

      statusBtn.disabled = true;
      statusBtn.textContent = 'Actualizando...';
      await updatePostStatus(id, newStatus);
      return;
    }

    const deleteBtn = (e.target as HTMLElement).closest('button[data-action="delete-post"]') as HTMLButtonElement | null;
    if (deleteBtn) {
      const id = deleteBtn.getAttribute('data-id');
      const title = deleteBtn.getAttribute('data-title') || 'este artículo';
      if (!id) return;

      deleteBtn.disabled = true;
      await deletePost(id, title);
    }
  });

  // Eventos para cambiar de pestaña
  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const status = btn.getAttribute('data-status');
      if (!status || status === currentStatus) return;

      currentStatus = status;

      // Actualizar estilos activos de las pestañas
      tabButtons.forEach((b) => {
        b.className = 'tab-btn px-4 py-2 text-sm font-semibold rounded-lg transition-all cursor-pointer text-gray-600 hover:text-gray-900';
      });
      btn.className = 'tab-btn px-4 py-2 text-sm font-semibold rounded-lg transition-all cursor-pointer bg-white text-blue-600 shadow-sm';

      loadPosts(currentStatus);
    });
  });

  // Envío del formulario para crear un nuevo artículo (en borrador)
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const originalText = submitBtn.textContent;
    submitBtn.textContent = 'Subiendo imágenes y guardando borrador...';
    submitBtn.disabled = true;

    const formData = new FormData(form);

    try {
      const response = await fetch(API_URL, {
        method: 'POST',
        headers: getAuthHeaders(),
        body: formData
      });

      if (response.ok) {
        statusMessage.textContent = '¡Borrador e imágenes guardados con éxito! Revísalo abajo en la pestaña de Borradores 🎉';
        statusMessage.className = 'mt-4 p-4 rounded-lg font-semibold text-center bg-green-100 text-green-700 block';
        form.reset();
        slugEditedManually = false;

        // Si estamos en la pestaña de borradores, recargamos la lista automáticamente
        if (currentStatus === 'draft') {
          await loadPosts('draft');
        }
      } else {
        const errData = await response.json().catch(() => ({}));
        throw new Error(errData.error || 'Error en el servidor');
      }
    } catch (error: any) {
      statusMessage.textContent = `Hubo un error al guardar el artículo: ${error.message || 'Verifica el servidor'}`;
      statusMessage.className = 'mt-4 p-4 rounded-lg font-semibold text-center bg-red-100 text-red-700 block';
    } finally {
      submitBtn.textContent = originalText;
      submitBtn.disabled = false;
    }
  });

  // Cargar los borradores al iniciar la página
  loadPosts(currentStatus);
</script>
