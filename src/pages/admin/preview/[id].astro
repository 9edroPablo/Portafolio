---
export const prerender = false;

const { id } = Astro.params;

let post = null;
try {
  const response = await fetch(`http://localhost:3000/api/posts/${id}`);
  
  const contentType = response.headers.get("content-type");
  if (contentType && contentType.includes("application/json")) {
    post = await response.json();
  } else {
    console.error("El backend no devolvió un JSON. Revisa que Node.js esté corriendo.");
  }
} catch (error) {
  console.error("Error conectando con el servidor backend:", error);
}

if (!post || post.error) {
  return Astro.redirect('/admin');
}
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Vista Previa: {post.title}</title>
    
    <style define:vars={{
      bgColor: post.bgColor || '#ffffff',
      textColor: post.textColor || '#1f2937',
      titleFont: post.titleFont || 'sans-serif'
    }}>
      body {
        background-color: var(--bgColor);
        color: var(--textColor);
        font-family: var(--titleFont), sans-serif;
        margin: 0;
        padding: 0;
        min-height: 100vh;
      }
      .preview-container {
        max-width: 800px;
        margin: 0 auto;
        padding: 2rem;
      }
      .badge {
        display: inline-block;
        background-color: #f59e0b;
        color: white;
        padding: 0.25rem 0.75rem;
        border-radius: 9999px;
        font-size: 0.875rem;
        font-weight: bold;
        margin-bottom: 2rem;
        text-transform: uppercase;
      }
      .technologies span {
        background-color: rgba(128, 128, 128, 0.2);
        padding: 0.25rem 0.5rem;
        border-radius: 4px;
        margin-right: 0.5rem;
        font-size: 0.875rem;
      }
      .image-container img {
        width: 100%;
        max-height: 400px;
        object-fit: cover;
        border-radius: 8px;
        margin-top: 1rem;
      }
      .content {
        margin-top: 2rem;
        line-height: 1.6;
      }
    </style>
  </head>
  <body>
    <div class="preview-container">
      <div class="badge">Modo Vista Previa - {post.status}</div>
      
      <h1>{post.title}</h1>
      
      <div class="technologies">
        {post.technologies && post.technologies.map((tech) => (
          <span>{tech}</span>
        ))}
      </div>

      {post.coverImage && (
        <div class="image-container">
          <img src={post.coverImage} alt="Imagen de portada" />
        </div>
      )}

      <div class="content">
        <p><strong>Resumen:</strong> {post.summary}</p>
        <div>
          {post.content}
        </div>
      </div>

      {post.contentImage && (
        <div class="image-container">
          <img src={post.contentImage} alt="Imagen de contenido" />
        </div>
      )}
    </div>
  </body>
</html>