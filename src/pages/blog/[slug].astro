---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';
const { slug } = Astro.params;

let post = null;
try {
  // Consultamos los artículos publicados filtrando por slug
  const response = await fetch(`${API_BASE}/api/posts?status=published&slug=${encodeURIComponent(slug || '')}`);
  const contentType = response.headers.get("content-type");
  if (response.ok && contentType && contentType.includes("application/json")) {
    const posts = await response.json();
    if (Array.isArray(posts)) {
      post = posts.find((p) => p.slug === slug) || null;
    }
  }
} catch (error) {
  console.error("Error conectando con el servidor backend:", error);
}

if (!post || post.error) {
  return Astro.redirect('/blog');
}
---

<Layout>
  <div class="post-theme-wrapper min-h-screen transition-colors">
    <main class="max-w-3xl mx-auto px-6 py-12">
      <a href="/blog" class="back-link inline-block mb-8 font-semibold hover:underline">
        &larr; Volver al blog
      </a>
      
      <article class="space-y-8">
        <header class="space-y-4">
          <h1 class="post-title text-4xl md:text-5xl font-extrabold leading-tight">
            {post.title}
          </h1>
          
          <time class="block text-sm opacity-75 font-medium">
            Publicado el {new Date(post.publishedAt).toLocaleDateString('es-ES', {
              day: '2-digit',
              month: 'long',
              year: 'numeric'
            })}
          </time>

          {Array.isArray(post.technologies) && post.technologies.length > 0 && (
            <div class="flex flex-wrap gap-2 pt-2">
              {post.technologies.map((tech: string) => (
                <span class="tech-badge px-3 py-1 rounded-md text-xs font-semibold">
                  {tech}
                </span>
              ))}
            </div>
          )}
        </header>

        {post.coverImage && (
          <div class="overflow-hidden rounded-2xl shadow-sm">
            <img
              src={post.coverImage}
              alt={`Portada de ${post.title}`}
              class="w-full max-h-[450px] object-cover"
            />
          </div>
        )}

        {post.summary && (
          <p class="text-xl font-medium opacity-90 leading-relaxed border-l-4 border-current pl-4">
            {post.summary}
          </p>
        )}
        
        <div class="post-content text-lg leading-relaxed whitespace-pre-line">
          {post.content}
        </div>

        {post.contentImage && (
          <div class="overflow-hidden rounded-2xl shadow-sm pt-4">
            <img
              src={post.contentImage}
              alt={`Imagen de contenido de ${post.title}`}
              class="w-full max-h-[450px] object-cover"
            />
          </div>
        )}
      </article>
    </main>
  </div>
</Layout>

<style define:vars={{
  bgColor: post.bgColor || '#ffffff',
  textColor: post.textColor || '#1f2937',
  titleFont: post.titleFont || 'sans-serif'
}}>
  .post-theme-wrapper {
    background-color: var(--bgColor);
    color: var(--textColor);
    font-family: var(--titleFont), sans-serif;
  }
  .post-title {
    font-family: var(--titleFont), sans-serif;
    color: var(--textColor);
  }
  .back-link {
    color: var(--textColor);
    opacity: 0.85;
  }
  .tech-badge {
    background-color: rgba(128, 128, 128, 0.2);
    color: var(--textColor);
  }
</style>
