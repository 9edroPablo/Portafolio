---
import Layout from '../../layouts/Layout.astro';

// 1. Astro ejecuta esto para saber cuántas páginas de artículos debe crear
export async function getStaticPaths() {
  // Pedimos todos los artículos a tu backend
  const response = await fetch('http://localhost:3000/api/posts');
  const posts = await response.json();

  // Le decimos a Astro que cree una ruta por cada 'slug' (ej. /blog/primer-post-mongodb)
  return posts.map((post) => {
    return {
      params: { slug: post.slug }, // Define la URL
      props: { post },             // Le pasa los datos del artículo a la página
    };
  });
}

// 2. Recibimos los datos del artículo específico para mostrarlo
const { post } = Astro.props;
---

<Layout>
  <main class="max-w-3xl mx-auto p-8 font-sans mt-10">
    <a href="/blog" class="text-blue-600 hover:underline mb-8 inline-block font-semibold">&larr; Volver al blog</a>
    
    <article class="bg-white p-8 md:p-12 rounded-2xl shadow-sm border border-gray-100">
      <h1 class="text-4xl md:text-5xl font-extrabold mb-6 text-gray-900 leading-tight">
        {post.title}
      </h1>
      
      <time class="text-gray-500 mb-8 block font-medium">
        Publicado el {new Date(post.publishedAt).toLocaleDateString('es-ES')}
      </time>
      
      <!-- Aquí renderizamos el contenido del artículo -->
      <div class="prose prose-lg max-w-none text-gray-700 leading-relaxed">
        {post.content}
      </div>
    </article>
  </main>
</Layout>