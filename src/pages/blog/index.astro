---
export const prerender = false;
import Layout from '../../layouts/Layout.astro';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

// Pedimos únicamente los artículos con estado 'published'
let posts = null;
try {
  const response = await fetch(`${API_BASE}/api/posts?status=published`);
  if (response.ok) {
    posts = await response.json();
  }
} catch (error) {
  console.error("Error conectando con el backend:", error);
}
---

<Layout>
  <main class="max-w-5xl mx-auto px-6 py-12 font-sans">
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Mi Blog</h1>
    <p class="text-xl text-gray-600 mb-10">Aquí comparto mis aprendizajes, tutoriales y experiencias sobre desarrollo web.</p>
    
    {Array.isArray(posts) ? (
      posts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {posts.map((post) => (
            <article class="flex flex-col p-8 bg-white rounded-2xl shadow-sm border border-gray-100 hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group">
              {post.coverImage && (
                <a href={`/blog/${post.slug}`} class="block mb-5 overflow-hidden rounded-xl">
                  <img
                    src={post.coverImage}
                    alt={post.title}
                    class="w-full h-52 object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </a>
              )}
              <time class="text-sm font-semibold text-blue-500 mb-2">
                {new Date(post.publishedAt).toLocaleDateString('es-ES', {
                  day: '2-digit',
                  month: 'long',
                  year: 'numeric'
                })}
              </time>
              <h2 class="text-2xl font-bold mb-3 text-gray-900">
                <a href={`/blog/${post.slug}`} class="group-hover:text-blue-600 transition-colors">
                  {post.title}
                </a>
              </h2>
              <p class="text-gray-600 flex-grow mb-6">{post.summary}</p>

              {Array.isArray(post.technologies) && post.technologies.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-6">
                  {post.technologies.map((tech: string) => (
                    <span class="px-2.5 py-1 text-xs font-medium bg-gray-100 text-gray-700 rounded-md">
                      {tech}
                    </span>
                  ))}
                </div>
              )}

              <a href={`/blog/${post.slug}`} class="mt-auto text-blue-600 font-semibold hover:text-blue-800">
                Leer artículo &rarr;
              </a>
            </article>
          ))}
        </div>
      ) : (
        <div class="p-12 bg-gray-50 rounded-2xl border border-dashed border-gray-200 text-center">
          <p class="text-gray-500 text-lg font-medium">Aún no hay artículos publicados en el blog.</p>
        </div>
      )
    ) : (
      <p class="text-red-600 font-medium">Error de conexión con el servidor. No se pudieron cargar los artículos.</p>
    )}
  </main>
</Layout>
