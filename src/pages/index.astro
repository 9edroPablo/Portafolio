---
export const prerender = false;
import Layout from '../layouts/Layout.astro';

const API_BASE = import.meta.env.PUBLIC_API_URL || 'http://localhost:3000';

// Traemos solo los artículos publicados y guardamos los primeros 2
let recentPosts = [];
try {
  const response = await fetch(`${API_BASE}/api/posts?status=published`);
  if (response.ok) {
    const allPosts = await response.json();
    if (Array.isArray(allPosts)) {
      recentPosts = allPosts.slice(0, 2);
    }
  }
} catch (error) {
  console.error("Error conectando con el backend:", error);
}
---

<Layout>
  <main class="max-w-5xl mx-auto px-6 py-12 font-sans space-y-16">
    
    <!-- SECCIÓN HERO -->
    <section class="py-8">
      <span class="inline-block px-3 py-1 text-xs font-bold tracking-wider text-blue-600 uppercase bg-blue-50 rounded-full mb-4">
        Desarrollador Full Stack
      </span>
      <h1 class="text-4xl md:text-6xl font-extrabold text-gray-900 tracking-tight mb-6">
        Hola, soy <span class="text-blue-600">Pedro</span>. Construyo experiencias web modernas.
      </h1>
      <p class="text-xl text-gray-600 max-w-2xl mb-8 leading-relaxed">
        Bienvenido a mi portafolio y blog personal, donde comparto mis proyectos, arquitectura de software y aprendizajes con Astro, Node.js y MongoDB.
      </p>
      <div class="flex flex-wrap gap-4">
        <a href="/blog" class="px-6 py-3 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-xl transition-colors">
          Explorar el Blog &rarr;
        </a>
      </div>
    </section>
    
    <!-- SECCIÓN DE BLOG RECIENTE -->
    <section>
      <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold text-gray-900">Últimos Artículos</h2>
        <a href="/blog" class="text-sm font-semibold text-blue-600 hover:text-blue-800">
          Ver todos &rarr;
        </a>
      </div>

      {recentPosts.length > 0 ? (
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {recentPosts.map((post) => (
            <article class="flex flex-col p-6 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-lg transition-all duration-300 group">
              {post.coverImage && (
                <a href={`/blog/${post.slug}`} class="block mb-4 overflow-hidden rounded-xl">
                  <img
                    src={post.coverImage}
                    alt={post.title}
                    class="w-full h-48 object-cover group-hover:scale-105 transition-transform duration-300"
                  />
                </a>
              )}
              <time class="text-xs font-semibold text-blue-500 mb-2">
                {new Date(post.publishedAt).toLocaleDateString('es-ES', {
                  day: '2-digit',
                  month: 'long',
                  year: 'numeric'
                })}
              </time>
              <h3 class="text-xl font-bold mb-2 text-gray-900">
                <a href={`/blog/${post.slug}`} class="group-hover:text-blue-600 transition-colors">
                  {post.title}
                </a>
              </h3>
              <p class="text-gray-600 flex-grow mb-4">{post.summary}</p>
              {Array.isArray(post.technologies) && post.technologies.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-auto pt-2">
                  {post.technologies.map((tech: string) => (
                    <span class="px-2.5 py-0.5 text-xs font-medium bg-gray-100 text-gray-700 rounded-md">
                      {tech}
                    </span>
                  ))}
                </div>
              )}
            </article>
          ))}
        </div>
      ) : (
        <div class="p-8 bg-gray-50 rounded-2xl border border-dashed border-gray-200 text-center">
          <p class="text-gray-500 font-medium">Aún no hay artículos publicados.</p>
        </div>
      )}
    </section>

  </main>
</Layout>
