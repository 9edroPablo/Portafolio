---
import Layout from '../layouts/Layout.astro';

// Traemos los artículos y guardamos solo los primeros 2
let recentPosts = [];
try {
  const response = await fetch('http://localhost:3000/api/posts');
  const allPosts = await response.json();
  recentPosts = allPosts.slice(0, 2); // Equivalente a [0...2] en Sanity
} catch (error) {
  console.error("Error conectando con el backend:", error);
}
---

<!-- Mantén tu HTML igual, pero puedes agregar la sección del blog que tenías antes si la borraste -->
<Layout>
  <main class="max-w-5xl mx-auto px-6 py-12 font-sans">
    
    <!-- (Mantén tu sección HERO y TECNOLOGÍAS igual) -->
    
    <!-- SECCIÓN DE BLOG RECIENTE (Agrégala si no la tienes) -->
    <section>
      <h2 class="text-2xl font-bold mb-6 text-gray-900">Últimos Artículos</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        {recentPosts.map((post) => (
           <article class="p-6 bg-white rounded-xl border border-gray-100 shadow-sm">
             <h3 class="text-xl font-bold mb-2"><a href={`/blog/${post.slug}`} class="hover:text-blue-600">{post.title}</a></h3>
             <p class="text-gray-600">{post.summary}</p>
           </article>
        ))}
      </div>
    </section>

  </main>
</Layout>